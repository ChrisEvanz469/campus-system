<%- include('../partials/header', { title: 'Clinic Overview Dashboard' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold text-dark mb-0">Clinic Overview Dashboard</h2>
    <p class="text-secondary small mb-0">Real-time clinical metrics, patient activity, and medical supply alerts</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/patients/new" class="btn btn-primary shadow-sm btn-sm">
      <i class="bi bi-person-plus me-1"></i> New Patient
    </a>
    <a href="/medicines" class="btn btn-outline-secondary shadow-sm btn-sm">
      <i class="bi bi-capsule me-1"></i> Pharmacy
    </a>
  </div>
</div>

<!-- Key Performance Metric Cards -->
<div class="row g-3 mb-4">
  <!-- Card 1: Total Registered Patients -->
  <div class="col-md-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-primary border-4">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-secondary small fw-semibold text-uppercase">Total Patients</div>
            <h3 class="fw-bold text-dark mb-0 mt-1"><%= stats.totalPatients %></h3>
          </div>
          <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3">
            <i class="bi bi-people-fill fs-4"></i>
          </div>
        </div>
        <div class="mt-3">
          <a href="/patients" class="text-decoration-none small fw-semibold text-primary">
            View patient directory &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 2: Today's Consultations -->
  <div class="col-md-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-success border-4">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-secondary small fw-semibold text-uppercase">Visits Today</div>
            <h3 class="fw-bold text-dark mb-0 mt-1"><%= stats.visitsToday %></h3>
          </div>
          <div class="bg-success bg-opacity-10 text-success rounded-circle p-3">
            <i class="bi bi-calendar2-check-fill fs-4"></i>
          </div>
        </div>
        <div class="mt-3">
          <span class="text-muted small">Daily clinic consultations</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 3: Total Recorded Consultations -->
  <div class="col-md-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-info border-4">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-secondary small fw-semibold text-uppercase">Total Visits</div>
            <h3 class="fw-bold text-dark mb-0 mt-1"><%= stats.totalVisits %></h3>
          </div>
          <div class="bg-info bg-opacity-10 text-info rounded-circle p-3">
            <i class="bi bi-clipboard2-pulse-fill fs-4"></i>
          </div>
        </div>
        <div class="mt-3">
          <span class="text-muted small">All-time medical consultations</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Card 4: Low Stock Medicine Alerts -->
  <div class="col-md-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-danger border-4">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <div class="text-secondary small fw-semibold text-uppercase">Supply Alerts</div>
            <h3 class="fw-bold text-dark mb-0 mt-1"><%= stats.lowStockCount %></h3>
          </div>
          <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-3">
            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
          </div>
        </div>
        <div class="mt-3">
          <a href="/medicines" class="text-decoration-none small fw-semibold text-danger">
            Restock pharmacy inventory &rarr;
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Left: Recent Consultation Visits -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-3 h-100">
      <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold text-primary text-uppercase small mb-0">
          <i class="bi bi-clipboard2-pulse me-1"></i> Recent Consultations
        </h6>
        <span class="badge bg-light text-secondary border">Latest 5 Records</span>
      </div>
      <div class="card-body p-0">
        <% if (recentVisits.length === 0) { %>
          <div class="text-center py-5 text-muted small">
            No clinical visits recorded yet.
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
              <thead class="table-light">
                <tr>
                  <th class="ps-3">Date</th>
                  <th>Patient</th>
                  <th>Chief Complaint</th>
                  <th>Diagnosis</th>
                  <th class="pe-3 text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                <% recentVisits.forEach(visit => { %>
                  <tr>
                    <td class="ps-3 text-nowrap"><%= new Date(visit.visit_date).toLocaleDateString() %></td>
                    <td>
                      <div class="fw-semibold"><%= visit.last_name %>, <%= visit.first_name %></div>
                      <div class="text-muted" style="font-size: 0.75rem;"><%= visit.id_number %></div>
                    </td>
                    <td><%= visit.chief_complaint %></td>
                    <td><%= visit.diagnosis || "Under observation" %></td>
                    <td class="pe-3 text-end">
                      <a href="/patients/<%= visit.patient_id %>" class="btn btn-sm btn-outline-primary" style="font-size: 0.75rem;">
                        View Profile
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Right: Recent Patient Registrations -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm rounded-3 h-100">
      <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold text-primary text-uppercase small mb-0">
          <i class="bi bi-person-check me-1"></i> Newly Enrolled Patients
        </h6>
      </div>
      <div class="card-body p-0">
        <% if (recentPatients.length === 0) { %>
          <div class="text-center py-5 text-muted small">
            No patients registered.
          </div>
        <% } else { %>
          <ul class="list-group list-group-flush small">
            <% recentPatients.forEach(p => { %>
              <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                <div>
                  <div class="fw-semibold text-dark"><%= p.last_name %>, <%= p.first_name %></div>
                  <div class="text-muted" style="font-size: 0.75rem;"><%= p.id_number %> &bull; <%= p.department_or_course || "Campus" %></div>
                </div>
                <a href="/patients/<%= p.id %>" class="btn btn-sm btn-light border" style="font-size: 0.75rem;">
                  <i class="bi bi-arrow-right"></i>
                </a>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
