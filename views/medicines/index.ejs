<%- include('../partials/header', { title: 'Pharmacy Inventory' }) %>

<% if (typeof message !== "undefined" && message) { %>
  <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center mb-4" role="alert">
    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
    <div><%= message %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold text-dark mb-0">Clinic Pharmacy Inventory</h2>
    <p class="text-secondary small mb-0">Monitor essential medical supplies, expiration dates, and dispense logs</p>
  </div>
  <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addMedicineModal">
    <i class="bi bi-plus-circle me-1"></i> Add Supply
  </button>
</div>

<!-- Search & Low Stock Toggle Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-3 p-3 bg-white">
  <div class="row g-2 align-items-center">
    <div class="col-md-6 col-lg-5">
      <div class="input-group">
        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
        <input type="text" id="medSearchInput" class="form-control border-start-0" placeholder="Search medicine name or category...">
      </div>
    </div>
    <div class="col-md-6 col-lg-7 d-flex align-items-center justify-content-md-end gap-2">
      <button type="button" id="toggleLowStockBtn" class="btn btn-sm btn-outline-danger">
        <i class="bi bi-exclamation-triangle me-1"></i> Show Low Stock Only
      </button>
      <button type="button" id="resetMedFiltersBtn" class="btn btn-sm btn-light border text-secondary">
        Reset
      </button>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" id="medsTable">
        <thead class="table-light border-bottom">
          <tr>
            <th class="ps-4">Medicine / Supply</th>
            <th>Category</th>
            <th>Stock Level</th>
            <th>Unit</th>
            <th>Expiration Date</th>
            <th class="text-end pe-4">Stock Action</th>
          </tr>
        </thead>
        <tbody id="medsTableBody">
          <% if (medicines.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">No supplies recorded in the pharmacy database.</td>
            </tr>
          <% } else { %>
            <% medicines.forEach(med => { %>
              <tr class="med-row" 
                  data-lowstock="<%= med.stock_quantity <= 50 ? 'true' : 'false' %>"
                  data-search="<%= (med.name + ' ' + (med.category || '')).toLowerCase() %>">
                <td class="ps-4 fw-semibold text-dark"><%= med.name %></td>
                <td><span class="badge bg-light text-secondary border"><%= med.category || "General" %></span></td>
                <td>
                  <% if (med.stock_quantity <= 50) { %>
                    <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock: <%= med.stock_quantity %></span>
                  <% } else { %>
                    <span class="badge bg-success"><%= med.stock_quantity %> In Stock</span>
                  <% } %>
                </td>
                <td class="text-muted"><%= med.unit %></td>
                <td><%= med.expiration_date ? new Date(med.expiration_date).toLocaleDateString() : "N/A" %></td>
                <td class="text-end pe-4">
                  <form action="/medicines/<%= med.id %>/adjust" method="POST" class="d-inline-flex gap-1 align-items-center justify-content-end">
                    <input type="number" name="amount" min="1" max="<%= med.stock_quantity %>" value="1" class="form-control form-control-sm text-center" style="width: 65px;" required>
                    <button type="submit" name="action" value="dispense" class="btn btn-sm btn-outline-danger" <%= med.stock_quantity === 0 ? "disabled" : "" %>>
                      <i class="bi bi-box-arrow-up-right me-1"></i>Dispense
                    </button>
                    <button type="submit" name="action" value="restock" class="btn btn-sm btn-outline-success">
                      <i class="bi bi-plus-lg"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } %>
          <!-- Dynamic Empty State -->
          <tr id="noMedsRow" style="display: none;">
            <td colspan="6" class="text-center py-5 text-muted">
              <i class="bi bi-search fs-3 d-block mb-2 text-secondary"></i>
              No medicine supplies match your query.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal: Add New Medicine -->
<div class="modal fade" id="addMedicineModal" tabindex="-1" aria-labelledby="addMedicineModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <form action="/medicines" method="POST">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title fw-bold" id="addMedicineModalLabel">
            <i class="bi bi-capsule me-2"></i>Add Medicine to Inventory
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Item Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Ibuprofen 200mg" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Category</label>
            <input type="text" name="category" class="form-control" placeholder="e.g. Pain Reliever, Antibiotic">
          </div>
          <div class="row g-2 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Initial Stock</label>
              <input type="number" name="stock_quantity" class="form-control" value="100" min="0">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Unit Type</label>
              <input type="text" name="unit" class="form-control" placeholder="e.g. tablets, bottles, sachets">
            </div>
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Expiration Date</label>
            <input type="date" name="expiration_date" class="form-control">
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm px-4">
            <i class="bi bi-save me-1"></i> Save to Inventory
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const medSearchInput = document.getElementById('medSearchInput');
    const toggleLowStockBtn = document.getElementById('toggleLowStockBtn');
    const resetMedFiltersBtn = document.getElementById('resetMedFiltersBtn');
    const medRows = document.querySelectorAll('.med-row');
    const noMedsRow = document.getElementById('noMedsRow');

    let lowStockOnly = false;

    function filterMeds() {
      const query = medSearchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      medRows.forEach(row => {
        const isLow = row.dataset.lowstock === 'true';
        const matchesStock = !lowStockOnly || isLow;
        const matchesQuery = !query || row.dataset.search.includes(query);

        if (matchesStock && matchesQuery) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (noMedsRow) {
        noMedsRow.style.display = (visibleCount === 0 && medRows.length > 0) ? '' : 'none';
      }
    }

    medSearchInput.addEventListener('input', filterMeds);

    toggleLowStockBtn.addEventListener('click', () => {
      lowStockOnly = !lowStockOnly;
      if (lowStockOnly) {
        toggleLowStockBtn.classList.remove('btn-outline-danger');
        toggleLowStockBtn.classList.add('btn-danger');
      } else {
        toggleLowStockBtn.classList.remove('btn-danger');
        toggleLowStockBtn.classList.add('btn-outline-danger');
      }
      filterMeds();
    });

    resetMedFiltersBtn.addEventListener('click', () => {
      medSearchInput.value = '';
      lowStockOnly = false;
      toggleLowStockBtn.classList.remove('btn-danger');
      toggleLowStockBtn.classList.add('btn-outline-danger');
      filterMeds();
    });
  });
</script>

<%- include('../partials/footer') %>
