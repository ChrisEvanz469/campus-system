<%- include('../partials/header', { title: 'Pharmacy Inventory' }) %>

<% if (typeof message !== "undefined" && message) { %>
  <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center mb-4" role="alert">
    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
    <div><%= message %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold text-dark mb-0">Clinic Pharmacy Inventory</h2>
    <p class="text-secondary small mb-0">Monitor essential medical supplies, expiration dates, and dispense logs</p>
  </div>
  <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#addMedicineModal">
    <i class="bi bi-plus-circle me-1"></i> Add Supply
  </button>
</div>

<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light border-bottom">
          <tr>
            <th class="ps-4">Medicine / Supply</th>
            <th>Category</th>
            <th>Stock Level</th>
            <th>Unit</th>
            <th>Expiration Date</th>
            <th class="text-end pe-4">Stock Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (medicines.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">No supplies recorded in the pharmacy database.</td>
            </tr>
          <% } else { %>
            <% medicines.forEach(med => { %>
              <tr>
                <td class="ps-4 fw-semibold text-dark"><%= med.name %></td>
                <td><span class="badge bg-light text-secondary border"><%= med.category || "General" %></span></td>
                <td>
                  <% if (med.stock_quantity <= 50) { %>
                    <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>Low Stock: <%= med.stock_quantity %></span>
                  <% } else { %>
                    <span class="badge bg-success"><%= med.stock_quantity %> In Stock</span>
                  <% } %>
                </td>
                <td class="text-muted"><%= med.unit %></td>
                <td><%= med.expiration_date ? new Date(med.expiration_date).toLocaleDateString() : "N/A" %></td>
                <td class="text-end pe-4">
                  <!-- Quick Dispense Form -->
                  <form action="/medicines/<%= med.id %>/adjust" method="POST" class="d-inline-flex gap-1 align-items-center justify-content-end">
                    <input type="number" name="amount" min="1" max="<%= med.stock_quantity %>" value="1" class="form-control form-control-sm text-center" style="width: 65px;" required>
                    <button type="submit" name="action" value="dispense" class="btn btn-sm btn-outline-danger" <%= med.stock_quantity === 0 ? "disabled" : "" %>>
                      <i class="bi bi-box-arrow-up-right me-1"></i>Dispense
                    </button>
                    <button type="submit" name="action" value="restock" class="btn btn-sm btn-outline-success">
                      <i class="bi bi-plus-lg"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal: Add New Medicine -->
<div class="modal fade" id="addMedicineModal" tabindex="-1" aria-labelledby="addMedicineModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <form action="/medicines" method="POST">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title fw-bold" id="addMedicineModalLabel">
            <i class="bi bi-capsule me-2"></i>Add Medicine to Inventory
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Item Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Ibuprofen 200mg" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Category</label>
            <input type="text" name="category" class="form-control" placeholder="e.g. Pain Reliever, Antibiotic">
          </div>
          <div class="row g-2 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Initial Stock</label>
              <input type="number" name="stock_quantity" class="form-control" value="100" min="0">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Unit Type</label>
              <input type="text" name="unit" class="form-control" placeholder="e.g. tablets, bottles, sachets">
            </div>
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold">Expiration Date</label>
            <input type="date" name="expiration_date" class="form-control">
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm px-4">
            <i class="bi bi-save me-1"></i> Save to Inventory
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
