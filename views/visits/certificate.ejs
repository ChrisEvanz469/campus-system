<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Medical Certificate - <%= visit.last_name %>, <%= visit.first_name %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background-color: #f4f6f9;
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }
    .cert-paper {
      background: #ffffff;
      max-width: 800px;
      margin: 30px auto;
      padding: 50px 60px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      border-top: 6px solid #0d6efd;
      border-radius: 4px;
    }
    .cert-seal {
      font-size: 55px;
      color: #0d6efd;
    }
    .cert-title {
      letter-spacing: 2px;
      font-weight: 800;
      color: #1a202c;
    }
    .cert-body {
      font-size: 1.05rem;
      line-height: 1.8;
      color: #2d3748;
    }
    .underline-value {
      border-bottom: 1.5px solid #2d3748;
      padding: 0 6px;
      font-weight: 600;
      color: #0d6efd;
    }
    .signature-line {
      border-top: 1.5px solid #2d3748;
      width: 250px;
      margin-top: 60px;
    }

    /* Print Specific Styles */
    @media print {
      body {
        background-color: #ffffff;
        margin: 0;
        padding: 0;
      }
      .no-print {
        display: none !important;
      }
      .cert-paper {
        box-shadow: none !important;
        margin: 0 auto !important;
        padding: 30px 40px !important;
        border-top: 4px solid #0d6efd !important;
        max-width: 100% !important;
      }
    }
  </style>
</head>
<body>

  <!-- Top Action Bar (Hidden when printing) -->
  <div class="no-print bg-dark py-3 mb-4 shadow-sm">
    <div class="container d-flex justify-content-between align-items-center" style="max-width: 800px;">
      <a href="/patients/<%= visit.patient_db_id %>" class="btn btn-outline-light btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Return to Profile
      </a>
      <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-primary btn-sm px-4 fw-semibold shadow-sm">
          <i class="bi bi-printer-fill me-1"></i> Print / Save as PDF
        </button>
      </div>
    </div>
  </div>

  <!-- Medical Certificate Document Sheet -->
  <div class="cert-paper">
    <!-- Header -->
    <div class="text-center pb-3 border-bottom mb-4">
      <div class="cert-seal mb-1"><i class="bi bi-hospital"></i></div>
      <h5 class="fw-bold mb-0 text-uppercase tracking-wide">University Health & Medical Services</h5>
      <p class="text-secondary small mb-0">Campus Clinic & Infirmary Unit &bull; Student & Personnel Wellness</p>
      <div class="text-muted small mt-1">Control Ref No: <strong>CCMS-<%= new Date(visit.visit_date).getFullYear() %>-<%= String(visit.id).padStart(5, '0') %></strong></div>
    </div>

    <!-- Title -->
    <div class="text-center my-4">
      <h4 class="cert-title text-uppercase mb-1">Medical Certificate</h4>
      <p class="text-muted small fst-italic">Official Campus Health Record & Clinical Clearance</p>
    </div>

    <!-- Date of Examination -->
    <div class="d-flex justify-content-between mb-4 small">
      <div><strong>Date Issued:</strong> <%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
      <div><strong>Date Examined:</strong> <%= new Date(visit.visit_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
    </div>

    <!-- Certification Statement -->
    <div class="cert-body mb-4">
      <p>
        <strong>TO WHOM IT MAY CONCERN:</strong>
      </p>
      <p>
        This is to certify that 
        <span class="underline-value"><%= visit.last_name %>, <%= visit.first_name %></span>, 
        identified by University ID Number <span class="underline-value"><%= visit.id_number %></span>, 
        affiliated as <span class="underline-value text-capitalize"><%= visit.patient_type %></span> 
        under the department or course <span class="underline-value"><%= visit.department_or_course || 'General Campus' %></span>, 
        was evaluated and attended to at the University Health Services Unit with the chief complaint of 
        <span class="underline-value"><%= visit.chief_complaint %></span>.
      </p>

      <!-- Vital Signs Recorded -->
      <div class="card bg-light border-0 my-3 p-3">
        <h6 class="fw-bold text-uppercase small text-secondary mb-2">Vitals Recorded Upon Examination:</h6>
        <div class="row g-2 small">
          <div class="col-4"><strong>Blood Pressure:</strong> <%= visit.blood_pressure || 'Not recorded' %></div>
          <div class="col-4"><strong>Body Temperature:</strong> <%= visit.temperature ? visit.temperature + ' &deg;C' : 'Not recorded' %></div>
          <div class="col-4"><strong>Pulse Rate:</strong> <%= visit.pulse_rate ? visit.pulse_rate + ' bpm' : 'Not recorded' %></div>
        </div>
      </div>

      <!-- Findings & Diagnosis -->
      <p class="mb-2">
        <strong>Clinical Impression / Diagnosis:</strong>
        <br>
        <span class="fw-semibold text-dark"><%= visit.diagnosis || 'Symptomatic Treatment & Medical Observation' %></span>
      </p>

      <!-- Remarks and Recommendations -->
      <p class="mb-3">
        <strong>Management & Medical Recommendations:</strong>
        <br>
        <span class="text-dark"><%= visit.treatment || 'Prescribed oral medication and adequate oral hydration.' %></span>
        <% if (visit.remarks) { %>
          <br>
          <span class="text-secondary small fst-italic">Doctor's Note: <%= visit.remarks %></span>
        <% } %>
      </p>

      <p class="small text-muted mb-0">
        This document is issued upon request of the patient for academic, official excuse, or medical documentation purposes.
      </p>
    </div>

    <!-- Sign-off Block -->
    <div class="row pt-4 mt-4">
      <div class="col-6">
        <div class="small text-muted">
          <em>Clinic Official Seal / Stamp</em>
          <div class="border rounded-2 p-3 mt-2 text-center text-secondary border-dashed" style="height: 90px; width: 180px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem;">
            VALID ONLY WITH OFFICIAL CLINIC STAMP
          </div>
        </div>
      </div>
      <div class="col-6 text-end">
        <div class="d-inline-block text-center">
          <div class="signature-line"></div>
          <div class="fw-bold text-dark mt-2"><%= visit.attending_staff || 'Authorized Medical Officer' %></div>
          <div class="text-secondary small text-capitalize"><%= visit.staff_role || 'Attending Physician / Campus Nurse' %></div>
          <div class="text-muted" style="font-size: 0.75rem;">Licensed Campus Health Provider</div>
        </div>
      </div>
    </div>
  </div>

</body>
</html>
