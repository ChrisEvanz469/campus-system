<%- include('../partials/header', { title: patient.first_name + " " + patient.last_name + " - Medical Profile" }) %>

<% if (typeof visitMessage !== "undefined" && visitMessage) { %>
  <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center mb-4" role="alert">
    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
    <div><%= visitMessage %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h3 class="fw-bold text-dark mb-0"><%= patient.last_name %>, <%= patient.first_name %></h3>
    <span class="badge text-capitalize <%= patient.patient_type === 'student' ? 'bg-info text-dark' : (patient.patient_type === 'faculty' ? 'bg-success' : 'bg-secondary') %>">
      <%= patient.patient_type %>
    </span>
    <span class="text-secondary small ms-2">University ID: <strong><%= patient.id_number %></strong></span>
  </div>
  <div class="d-flex gap-2">
    <a href="/patients" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i> Directory
    </a>
    <button type="button" class="btn btn-primary btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#recordVisitModal">
      <i class="bi bi-plus-circle me-1"></i> Record Consultation
    </button>
  </div>
</div>

<div class="row g-4">
  <!-- Left Column: Patient Bio & Emergency Info -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm rounded-3 mb-4">
      <div class="card-header bg-white border-0 pt-4 pb-0">
        <h6 class="fw-bold text-primary text-uppercase small mb-0">
          <i class="bi bi-person-lines-fill me-1"></i> Demographics
        </h6>
      </div>
      <div class="card-body">
        <ul class="list-group list-group-flush small">
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-secondary">Gender</span>
            <span class="fw-semibold text-capitalize"><%= patient.gender %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-secondary">Department / Course</span>
            <span class="fw-semibold"><%= patient.department_or_course || 'N/A' %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-secondary">Date of Birth</span>
            <span class="fw-semibold"><%= patient.birth_date ? new Date(patient.birth_date).toLocaleDateString() : 'Not recorded' %></span>
          </li>
          <li class="list-group-item d-flex justify-content-between px-0">
            <span class="text-secondary">Contact Number</span>
            <span class="fw-semibold"><%= patient.contact_number || 'N/A' %></span>
          </li>
        </ul>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 bg-light border-start border-danger border-4">
      <div class="card-body">
        <h6 class="fw-bold text-danger text-uppercase small mb-2">
          <i class="bi bi-shield-exclamation me-1"></i> Emergency Contact
        </h6>
        <p class="mb-1 small">
          <strong>Contact Person:</strong> <%= patient.emergency_contact || 'None registered' %>
        </p>
        <p class="mb-0 small">
          <strong>Emergency Phone:</strong> <%= patient.emergency_phone || 'None registered' %>
        </p>
      </div>
    </div>
  </div>

  <!-- Right Column: Medical Consultations History -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white border-0 pt-4 pb-2 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold text-primary text-uppercase small mb-0">
          <i class="bi bi-clipboard2-pulse me-1"></i> Consultation History (<%= visits.length %>)
        </h6>
      </div>
      <div class="card-body p-0">
        <% if (visits.length === 0) { %>
          <div class="text-center py-5 text-muted small">
            <i class="bi bi-folder2-open fs-2 d-block text-secondary mb-2"></i>
            No clinical consultations recorded yet for this patient.
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
              <thead class="table-light">
                <tr>
                  <th class="ps-3">Date</th>
                  <th>Complaint</th>
                  <th>Vitals</th>
                  <th>Diagnosis & Dispensed Treatment</th>
                  <th>Attending</th>
                  <th class="pe-3 text-end">Certificate</th>
                </tr>
              </thead>
              <tbody>
                <% visits.forEach(visit => { %>
                  <tr>
                    <td class="ps-3 text-nowrap"><%= new Date(visit.visit_date).toLocaleDateString() %></td>
                    <td class="fw-medium"><%= visit.chief_complaint %></td>
                    <td>
                      <div><span class="badge bg-light text-dark border">BP: <%= visit.blood_pressure || '--' %></span></div>
                      <div class="mt-1">
                        <span class="badge bg-light text-dark border">Temp: <%= visit.temperature ? visit.temperature + ' &deg;C' : '--' %></span>
                        <span class="badge bg-light text-dark border">HR: <%= visit.pulse_rate ? visit.pulse_rate + ' bpm' : '--' %></span>
                      </div>
                    </td>
                    <td>
                      <div><strong>Dx:</strong> <%= visit.diagnosis || 'None' %></div>
                      <div class="text-primary small mt-1">
                        <i class="bi bi-capsule me-1"></i><%= visit.treatment || 'None' %>
                      </div>
                      <% if (visit.remarks) { %>
                        <div class="text-muted fst-italic mt-1" style="font-size: 0.75rem;"><%= visit.remarks %></div>
                      <% } %>
                    </td>
                    <td class="text-nowrap">
                      <%= visit.attending_staff || 'Staff' %>
                      <div class="text-muted text-capitalize" style="font-size: 0.75rem;"><%= visit.staff_role || 'Medical Personnel' %></div>
                    </td>
                    <td class="pe-3 text-end">
                      <a href="/patients/<%= patient.id %>/visits/<%= visit.id %>/certificate" target="_blank" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-printer me-1"></i> Med Cert
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Record Consultation Visit -->
<div class="modal fade" id="recordVisitModal" tabindex="-1" aria-labelledby="recordVisitModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <form action="/patients/<%= patient.id %>/visits" method="POST">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title fw-bold" id="recordVisitModalLabel">
            <i class="bi bi-clipboard2-pulse me-2"></i>Record Clinical Consultation
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4">
          <!-- Attending Staff -->
          <div class="mb-3">
            <label class="form-label small fw-semibold">Attending Medical Personnel</label>
            <select name="attending_user_id" class="form-select">
              <option value="">-- Select Attending Staff --</option>
              <% staff.forEach(member => { %>
                <option value="<%= member.id %>"><%= member.full_name %> (<%= member.role %>)</option>
              <% }); %>
            </select>
          </div>

          <!-- Chief Complaint -->
          <div class="mb-3">
            <label class="form-label small fw-semibold">Chief Complaint / Symptoms <span class="text-danger">*</span></label>
            <textarea name="chief_complaint" class="form-control" rows="2" placeholder="e.g. Fever, acute stomach pain, headache" required></textarea>
          </div>

          <!-- Vitals (3 Columns) -->
          <h6 class="text-primary text-uppercase fw-bold small mt-4 mb-2 border-bottom pb-1">
            <i class="bi bi-activity me-1"></i> Patient Vital Signs
          </h6>
          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Blood Pressure</label>
              <input type="text" name="blood_pressure" class="form-control" placeholder="e.g. 120/80">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Temperature (&deg;C)</label>
              <input type="number" step="0.1" name="temperature" class="form-control" placeholder="e.g. 37.5">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Pulse Rate (BPM)</label>
              <input type="number" name="pulse_rate" class="form-control" placeholder="e.g. 80">
            </div>
          </div>

          <!-- Clinical Diagnosis -->
          <h6 class="text-primary text-uppercase fw-bold small mt-4 mb-2 border-bottom pb-1">
            <i class="bi bi-clipboard-check me-1"></i> Clinical Diagnosis
          </h6>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Diagnosis</label>
            <input type="text" name="diagnosis" class="form-control" placeholder="e.g. Acute Gastritis / Tension Headache">
          </div>

          <!-- Pharmacy Medicine Dispensing -->
          <h6 class="text-primary text-uppercase fw-bold small mt-4 mb-2 border-bottom pb-1">
            <i class="bi bi-capsule me-1"></i> Dispense Medication (Automatic Inventory Deduction)
          </h6>
          <div class="row g-2 mb-3">
            <div class="col-md-8">
              <label class="form-label small fw-semibold">Select In-Stock Medication</label>
              <select name="medicine_id" class="form-select">
                <option value="">-- No Medication Dispensed --</option>
                <% if (typeof medicines !== "undefined") { %>
                  <% medicines.forEach(med => { %>
                    <option value="<%= med.id %>">
                      <%= med.name %> (<%= med.stock_quantity %> <%= med.unit %> available)
                    </option>
                  <% }); %>
                <% } %>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Quantity to Dispense</label>
              <input type="number" name="dispense_quantity" class="form-control text-center" value="1" min="1">
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Additional Treatment / Dosage Instructions</label>
            <textarea name="additional_treatment" class="form-control" rows="2" placeholder="e.g. Take 1 tablet every 8 hours after meals. Drink plenty of water."></textarea>
          </div>

          <div class="mb-2">
            <label class="form-label small fw-semibold">Remarks / Recommendations</label>
            <input type="text" name="remarks" class="form-control" placeholder="e.g. Advised 1-day home rest; return if symptoms worsen">
          </div>
        </div>

        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm px-4">
            <i class="bi bi-save me-1"></i> Save Consultation & Dispense
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
