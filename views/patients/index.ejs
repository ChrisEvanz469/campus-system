<%- include('../partials/header', { title: 'Patients Directory' }) %>

<% if (typeof message !== "undefined" && message) { %>
  <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center mb-4" role="alert">
    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
    <div><%= message %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold text-dark mb-0">Patient Records</h2>
    <p class="text-secondary small mb-0">Manage registered students, faculty, and university personnel</p>
  </div>
  <a href="/patients/new" class="btn btn-primary shadow-sm">
    <i class="bi bi-person-plus me-1"></i> New Patient
  </a>
</div>

<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light border-bottom">
          <tr>
            <th class="ps-4">ID Number</th>
            <th>Full Name</th>
            <th>Classification</th>
            <th>Department / Course</th>
            <th>Contact</th>
            <th class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (patients.length === 0) { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">No patient records found in the clinic database.</td>
            </tr>
          <% } else { %>
            <% patients.forEach(patient => { %>
              <tr>
                <td class="ps-4 fw-semibold text-primary"><%= patient.id_number %></td>
                <td class="fw-medium"><%= patient.last_name %>, <%= patient.first_name %></td>
                <td>
                  <span class="badge text-capitalize <%= patient.patient_type === 'student' ? 'bg-info text-dark' : (patient.patient_type === 'faculty' ? 'bg-success' : 'bg-secondary') %>">
                    <%= patient.patient_type %>
                  </span>
                </td>
                <td><%= patient.department_or_course || '-' %></td>
                <td><%= patient.contact_number || '-' %></td>
                <td class="text-end pe-4">
                  <a href="/patients/<%= patient.id %>" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-eye"></i> View
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
