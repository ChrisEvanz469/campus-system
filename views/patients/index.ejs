<%- include('../partials/header', { title: 'Patients Directory' }) %>

<% if (typeof message !== "undefined" && message) { %>
  <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center mb-4" role="alert">
    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
    <div><%= message %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold text-dark mb-0">Patient Records</h2>
    <p class="text-secondary small mb-0">Manage registered students, faculty, and university personnel</p>
  </div>
  <a href="/patients/new" class="btn btn-primary shadow-sm">
    <i class="bi bi-person-plus me-1"></i> New Patient
  </a>
</div>

<!-- Search & Role Filter Bar -->
<div class="card border-0 shadow-sm rounded-3 mb-3 p-3 bg-white">
  <div class="row g-2 align-items-center">
    <div class="col-md-6 col-lg-5">
      <div class="input-group">
        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
        <input type="text" id="patientSearchInput" class="form-control border-start-0" placeholder="Search by name, ID number, or course...">
      </div>
    </div>
    <div class="col-md-6 col-lg-7 d-flex align-items-center justify-content-md-end gap-1 flex-wrap">
      <span class="small text-secondary fw-semibold me-1"><i class="bi bi-funnel me-1"></i>Role:</span>
      <button type="button" class="btn btn-sm btn-primary role-filter-btn" data-role="all">All (<%= patients.length %>)</button>
      <button type="button" class="btn btn-sm btn-outline-info text-dark role-filter-btn" data-role="student">Students</button>
      <button type="button" class="btn btn-sm btn-outline-success role-filter-btn" data-role="faculty">Faculty</button>
      <button type="button" class="btn btn-sm btn-outline-secondary role-filter-btn" data-role="staff">Staff</button>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" id="patientsTable">
        <thead class="table-light border-bottom">
          <tr>
            <th class="ps-4">ID Number</th>
            <th>Full Name</th>
            <th>Classification</th>
            <th>Department / Course</th>
            <th>Contact</th>
            <th class="text-end pe-4">Actions</th>
          </tr>
        </thead>
        <tbody id="patientsTableBody">
          <% if (patients.length === 0) { %>
            <tr id="emptyStaticRow">
              <td colspan="6" class="text-center py-5 text-muted">No patient records found in the clinic database.</td>
            </tr>
          <% } else { %>
            <% patients.forEach(patient => { %>
              <tr class="patient-row" 
                  data-role="<%= patient.patient_type.toLowerCase() %>" 
                  data-search="<%= (patient.id_number + ' ' + patient.first_name + ' ' + patient.last_name + ' ' + (patient.department_or_course || '')).toLowerCase() %>">
                <td class="ps-4 fw-semibold text-primary"><%= patient.id_number %></td>
                <td class="fw-medium"><%= patient.last_name %>, <%= patient.first_name %></td>
                <td>
                  <span class="badge text-capitalize <%= patient.patient_type === 'student' ? 'bg-info text-dark' : (patient.patient_type === 'faculty' ? 'bg-success' : 'bg-secondary') %>">
                    <%= patient.patient_type %>
                  </span>
                </td>
                <td><%= patient.department_or_course || '-' %></td>
                <td><%= patient.contact_number || '-' %></td>
                <td class="text-end pe-4">
                  <a href="/patients/<%= patient.id %>" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-eye"></i> View
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } %>
          <!-- Dynamic No Results Row -->
          <tr id="noResultsRow" style="display: none;">
            <td colspan="6" class="text-center py-5 text-muted">
              <i class="bi bi-search fs-3 d-block mb-2 text-secondary"></i>
              No patient records match your current search query or filter.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('patientSearchInput');
    const filterButtons = document.querySelectorAll('.role-filter-btn');
    const rows = document.querySelectorAll('.patient-row');
    const noResultsRow = document.getElementById('noResultsRow');

    let activeRole = 'all';

    function filterRecords() {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      rows.forEach(row => {
        const matchesRole = (activeRole === 'all') || (row.dataset.role === activeRole);
        const matchesQuery = !query || row.dataset.search.includes(query);

        if (matchesRole && matchesQuery) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (noResultsRow) {
        noResultsRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
      }
    }

    searchInput.addEventListener('input', filterRecords);

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('btn-primary', 'btn-info', 'btn-success', 'btn-secondary');
          b.classList.add('btn-outline-secondary');
        });

        btn.classList.remove('btn-outline-secondary');
        if (btn.dataset.role === 'all') btn.classList.add('btn-primary');
        if (btn.dataset.role === 'student') btn.classList.add('btn-info', 'text-dark');
        if (btn.dataset.role === 'faculty') btn.classList.add('btn-success');
        if (btn.dataset.role === 'staff') btn.classList.add('btn-secondary');

        activeRole = btn.dataset.role;
        filterRecords();
      });
    });
  });
</script>

<%- include('../partials/footer') %>
